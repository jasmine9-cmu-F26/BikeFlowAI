# Optional. Leave the data root unset to load the Git-tracked real M3 demo bundle.
# Use a forward-slash absolute path on Windows; never commit the actual .env.
# BIKEFLOW_DATA_ROOT=D:/data/chicago_historical_2021_sample
BIKEFLOW_LIVE=1
# Compose only: set true to install the additional CPU PPO runtime in the image.
BIKEFLOW_INSTALL_PPO=false
